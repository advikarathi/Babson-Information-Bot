# Copy this file to .env.local for local development. Never commit .env.local.

# Required. Your API key. Stays on the server; never goes in widget.js.
ANTHROPIC_API_KEY=

# Required when using a LiteLLM gateway key rather than a key from Anthropic.
# Leave it out to call Anthropic directly. No trailing slash.
ANTHROPIC_BASE_URL=

# Optional. Extra allowed origins, comma-separated, for sites outside babson.edu
# such as a Terminalfour preview host. Example: https://preview.example.com
ALLOWED_ORIGINS=
